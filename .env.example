# Application
ENV=development
LOG_LEVEL=INFO

# Database and Redis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/hetupr
REDIS_URL=redis://redis:6379/0

# GitHub App
GITHUB_APP_ID=your_github_app_id
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_secret
GITHUB_PRIVATE_KEY_PATH=./certs/github-private-key.pem

# OpenAI
OPENAI_API_KEY=replace_with_your_api_key
